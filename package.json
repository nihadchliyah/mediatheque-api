{
  "name": "mediatheque-api",
  "version": "1.0.0",
  "description": "API REST de la médiathèque associative en TypeScript",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "seed": "prisma db seed",
    "pretest": "node --env-file-if-exists=.env.test tests/preparer.ts",
    "test": "node --env-file-if-exists=.env.test --test --test-concurrency=1 tests/*.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jose": "^6.2.17",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "prisma": "^7.10.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
