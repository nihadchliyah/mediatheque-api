generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  membre
  bibliothecaire
}

model Utilisateur {
  id              Int            @id @default(autoincrement())
  email           String         @unique @db.VarChar(254)
  motDePasseHache String         @db.VarChar(100)
  role            Role           @default(membre)
  creeLe          DateTime       @default(now())
  majLe           DateTime       @updatedAt
  emprunts        Emprunt[]
  refreshTokens   RefreshToken[]

  @@map("utilisateurs")
}

model RefreshToken {
  id            Int         @id @default(autoincrement())
  jti           String      @unique @db.VarChar(64)
  utilisateurId Int
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  expireLe      DateTime
  revoqueLe     DateTime?
  creeLe        DateTime    @default(now())

  @@index([utilisateurId])
  @@map("refresh_tokens")
}

model Ouvrage {
  id         Int       @id @default(autoincrement())
  titre      String    @db.VarChar(150)
  auteur     String    @db.VarChar(100)
  annee      Int
  disponible Boolean   @default(true)
  creeLe     DateTime  @default(now())
  majLe      DateTime  @updatedAt
  emprunts   Emprunt[]

  @@unique([titre, auteur])
  @@map("ouvrages")
}

model Emprunt {
  id               Int         @id @default(autoincrement())
  ouvrageId        Int
  ouvrage          Ouvrage     @relation(fields: [ouvrageId], references: [id], onDelete: Restrict)
  utilisateurId    Int
  utilisateur      Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Restrict)
  dateEmprunt      DateTime    @default(now())
  dateRetourPrevue DateTime
  rendu            Boolean     @default(false)
  creeLe           DateTime    @default(now())
  majLe            DateTime    @updatedAt

  @@index([ouvrageId])
  @@index([utilisateurId])
  @@map("emprunts")
}
