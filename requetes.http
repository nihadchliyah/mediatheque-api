### Requêtes de test (extension VS Code « REST Client »)
### Lancer `npm run seed` avant pour partir d'un état connu, puis exécuter de haut en bas.

@base = http://localhost:3000
@json = application/json

### Santé — 200
GET {{base}}/sante

### Route inconnue — 404
GET {{base}}/nimporte-quoi

############################################
#             AUTHENTIFICATION
############################################

### Connexion bibliothécaire — 200
# @name biblio
POST {{base}}/api/auth/connexion
Content-Type: {{json}}

{
  "email": "biblio@example.net",
  "motDePasse": "Biblio-Demo-2026"
}

### Connexion membre (Camille) — 200
# @name camille
POST {{base}}/api/auth/connexion
Content-Type: {{json}}

{
  "email": "camille@example.net",
  "motDePasse": "Camille-Demo-2026"
}

@jetonBiblio = {{biblio.response.body.accessToken}}
@jetonMembre = {{camille.response.body.accessToken}}

### Connexion avec un mauvais mot de passe — 401
POST {{base}}/api/auth/connexion
Content-Type: {{json}}

{
  "email": "camille@example.net",
  "motDePasse": "Mauvais-Mot-2026"
}

### Connexion avec un compte inexistant — même 401
POST {{base}}/api/auth/connexion
Content-Type: {{json}}

{
  "email": "personne@example.net",
  "motDePasse": "Mauvais-Mot-2026"
}

### Inscription — 201 (le champ "role" est ignoré : le compte est membre)
POST {{base}}/api/auth/inscription
Content-Type: {{json}}

{
  "email": "nouveau@example.net",
  "motDePasse": "Nouveau-Membre-2026",
  "role": "bibliothecaire"
}

### Inscription avec un e-mail existant — 409
POST {{base}}/api/auth/inscription
Content-Type: {{json}}

{
  "email": "camille@example.net",
  "motDePasse": "Camille-Demo-2026"
}

### Rafraîchir — 200 (nouvelle paire de jetons)
# @name rafraichi
POST {{base}}/api/auth/rafraichir
Content-Type: {{json}}

{
  "refreshToken": "{{biblio.response.body.refreshToken}}"
}

### Rejouer l'ancien refresh token — 401 (révoque aussi les autres refresh tokens ; les access tokens restent valides 15 min)
POST {{base}}/api/auth/rafraichir
Content-Type: {{json}}

{
  "refreshToken": "{{biblio.response.body.refreshToken}}"
}

############################################
#                OUVRAGES
############################################

### Sans jeton — 401
GET {{base}}/api/ouvrages

### Jeton invalide — 401
GET {{base}}/api/ouvrages
Authorization: Bearer abc.def.ghi

### Lister (membre) — 200
GET {{base}}/api/ouvrages?page=1&limite=5
Authorization: Bearer {{jetonMembre}}

### Lister les ouvrages disponibles — 200
GET {{base}}/api/ouvrages?disponible=true
Authorization: Bearer {{jetonMembre}}

### Query string invalide — 400
GET {{base}}/api/ouvrages?page=0&disponible=peut-etre
Authorization: Bearer {{jetonMembre}}

### Détail (membre : seuls ses emprunts en cours) — 200
GET {{base}}/api/ouvrages/1
Authorization: Bearer {{jetonMembre}}

### Détail (bibliothécaire : tous les emprunts en cours) — 200
GET {{base}}/api/ouvrages/2
Authorization: Bearer {{jetonBiblio}}

### Identifiant inconnu — 404
GET {{base}}/api/ouvrages/9999
Authorization: Bearer {{jetonMembre}}

### Identifiant mal formé — 400
GET {{base}}/api/ouvrages/abc
Authorization: Bearer {{jetonMembre}}

### Créer en tant que membre — 403
POST {{base}}/api/ouvrages
Authorization: Bearer {{jetonMembre}}
Content-Type: {{json}}

{
  "titre": "Notre-Dame de Paris",
  "auteur": "Victor Hugo",
  "annee": 1831
}

### Créer en tant que bibliothécaire — 201
# @name nouvelOuvrage
POST {{base}}/api/ouvrages
Authorization: Bearer {{jetonBiblio}}
Content-Type: {{json}}

{
  "titre": "Notre-Dame de Paris",
  "auteur": "Victor Hugo",
  "annee": 1831
}

### Créer avec données invalides — 400
POST {{base}}/api/ouvrages
Authorization: Bearer {{jetonBiblio}}
Content-Type: {{json}}

{
  "titre": "",
  "annee": 1200
}

### Modifier — 200
PATCH {{base}}/api/ouvrages/{{nouvelOuvrage.response.body.id}}
Authorization: Bearer {{jetonBiblio}}
Content-Type: {{json}}

{
  "annee": 1832
}

### Modifier un ouvrage inconnu — 404
PATCH {{base}}/api/ouvrages/9999
Authorization: Bearer {{jetonBiblio}}
Content-Type: {{json}}

{
  "titre": "Fantôme"
}

### Supprimer un ouvrage emprunté — 409
DELETE {{base}}/api/ouvrages/1
Authorization: Bearer {{jetonBiblio}}

### Supprimer en tant que membre — 403
DELETE {{base}}/api/ouvrages/5
Authorization: Bearer {{jetonMembre}}

############################################
#                EMPRUNTS
############################################

### Lister (membre : uniquement les siens) — 200
GET {{base}}/api/emprunts
Authorization: Bearer {{jetonMembre}}

### Lister (bibliothécaire : tous) — 200
GET {{base}}/api/emprunts?rendu=false
Authorization: Bearer {{jetonBiblio}}

### Filtrer par utilisateur (bibliothécaire) — 200
GET {{base}}/api/emprunts?utilisateurId=3
Authorization: Bearer {{jetonBiblio}}

### Emprunt d'un autre membre (Léo) vu par Camille — 404
GET {{base}}/api/emprunts/2
Authorization: Bearer {{jetonMembre}}

### Son propre emprunt — 200
GET {{base}}/api/emprunts/1
Authorization: Bearer {{jetonMembre}}

### Emprunter (membre, pour lui-même ; utilisateurId est ignoré) — 201
# @name nouvelEmprunt
POST {{base}}/api/emprunts
Authorization: Bearer {{jetonMembre}}
Content-Type: {{json}}

{
  "ouvrageId": {{nouvelOuvrage.response.body.id}},
  "utilisateurId": 3,
  "dateRetourPrevue": "2026-12-31"
}

### Emprunter un ouvrage indisponible — 409
POST {{base}}/api/emprunts
Authorization: Bearer {{jetonMembre}}
Content-Type: {{json}}

{
  "ouvrageId": {{nouvelOuvrage.response.body.id}},
  "dateRetourPrevue": "2026-12-31"
}

### Emprunt pour un membre par le bibliothécaire — 201
POST {{base}}/api/emprunts
Authorization: Bearer {{jetonBiblio}}
Content-Type: {{json}}

{
  "ouvrageId": 5,
  "utilisateurId": 3,
  "dateRetourPrevue": "2026-12-31"
}

### Emprunt invalide — 400
POST {{base}}/api/emprunts
Authorization: Bearer {{jetonMembre}}
Content-Type: {{json}}

{
  "ouvrageId": 4,
  "dateRetourPrevue": "31/12/2026"
}

### Modifier en tant que membre — 403
PATCH {{base}}/api/emprunts/{{nouvelEmprunt.response.body.id}}
Authorization: Bearer {{jetonMembre}}
Content-Type: {{json}}

{
  "dateRetourPrevue": "2027-01-15"
}

### Modifier (bibliothécaire) — 200 ; utilisateurId est ignoré
PATCH {{base}}/api/emprunts/{{nouvelEmprunt.response.body.id}}
Authorization: Bearer {{jetonBiblio}}
Content-Type: {{json}}

{
  "dateRetourPrevue": "2027-01-15T10:00:00Z",
  "utilisateurId": 3
}

### Clôturer l'emprunt d'un autre — 404
POST {{base}}/api/emprunts/2/retour
Authorization: Bearer {{jetonMembre}}

### Clôturer son emprunt — 200
POST {{base}}/api/emprunts/{{nouvelEmprunt.response.body.id}}/retour
Authorization: Bearer {{jetonMembre}}

### Retour déjà effectué — 409
POST {{base}}/api/emprunts/{{nouvelEmprunt.response.body.id}}/retour
Authorization: Bearer {{jetonMembre}}

### Supprimer en tant que membre — 403
DELETE {{base}}/api/emprunts/{{nouvelEmprunt.response.body.id}}
Authorization: Bearer {{jetonMembre}}

### Supprimer (bibliothécaire) — 204
DELETE {{base}}/api/emprunts/{{nouvelEmprunt.response.body.id}}
Authorization: Bearer {{jetonBiblio}}

############################################
#              RÉSERVATIONS
############################################
### Seed : Léo réserve l'ouvrage 1 (emprunté par Camille), Camille réserve l'ouvrage 2 (emprunté par Léo).

### Lister (membre : uniquement les siennes) — 200
GET {{base}}/api/reservations
Authorization: Bearer {{jetonMembre}}

### Lister (bibliothécaire : toutes, filtrables par ouvrage) — 200
GET {{base}}/api/reservations?ouvrageId=1
Authorization: Bearer {{jetonBiblio}}

### Réserver un ouvrage disponible — 409 (il faut l'emprunter directement)
POST {{base}}/api/reservations
Authorization: Bearer {{jetonMembre}}
Content-Type: {{json}}

{ "ouvrageId": 4 }

### Réserver un ouvrage qu'on emprunte déjà — 409
POST {{base}}/api/reservations
Authorization: Bearer {{jetonMembre}}
Content-Type: {{json}}

{ "ouvrageId": 1 }

### Deuxième réservation du même ouvrage — 409 (contrainte d'unicité)
POST {{base}}/api/reservations
Authorization: Bearer {{jetonMembre}}
Content-Type: {{json}}

{ "ouvrageId": 2 }

### Réserver un ouvrage inconnu — 404
POST {{base}}/api/reservations
Authorization: Bearer {{jetonMembre}}
Content-Type: {{json}}

{ "ouvrageId": 9999 }

### Réservation invalide — 400
POST {{base}}/api/reservations
Authorization: Bearer {{jetonMembre}}
Content-Type: {{json}}

{ "ouvrageId": "cinq" }

### Réserver en tant que bibliothécaire — 403
POST {{base}}/api/reservations
Authorization: Bearer {{jetonBiblio}}
Content-Type: {{json}}

{ "ouvrageId": 5 }

### Réserver l'ouvrage 5, emprunté par Léo — 201 (rang dans la file)
# @name nouvelleReservation
POST {{base}}/api/reservations
Authorization: Bearer {{jetonMembre}}
Content-Type: {{json}}

{ "ouvrageId": 5 }

### Réservation d'un autre membre (Léo) vue par Camille — 404
GET {{base}}/api/reservations/1
Authorization: Bearer {{jetonMembre}}

### Annuler la réservation d'un autre membre — 404
DELETE {{base}}/api/reservations/1
Authorization: Bearer {{jetonMembre}}

### Annuler sa réservation — 204
DELETE {{base}}/api/reservations/{{nouvelleReservation.response.body.id}}
Authorization: Bearer {{jetonMembre}}

### Retour de l'emprunt de Léo (ouvrage 2) — 200 : la réservation de Camille devient un emprunt (empruntSuivant)
POST {{base}}/api/emprunts/2/retour
Authorization: Bearer {{jetonBiblio}}

### Camille voit son nouvel emprunt de l'ouvrage 2 — 200
GET {{base}}/api/emprunts?rendu=false
Authorization: Bearer {{jetonMembre}}

############################################
#              ASSISTANT (SSE)
############################################
### Le flux complet s'affiche à la fin de la réponse ; pour le voir arriver en direct : curl -N (voir README).

### Question sur le catalogue — 200 (text/event-stream : event: outil, data: {"texte"}, event: fin)
POST {{base}}/api/assistant/flux
Authorization: Bearer {{jetonMembre}}
Content-Type: {{json}}

{ "question": "Quels livres de Camus sont disponibles ?" }

### Question sur ses emprunts — 200 (outil mes_emprunts, limité au membre connecté)
POST {{base}}/api/assistant/flux
Authorization: Bearer {{jetonMembre}}
Content-Type: {{json}}

{ "question": "Quels sont mes emprunts ? Et ceux de leo@example.net ?" }

### Question sur ses réservations — 200 (outil mes_reservations)
POST {{base}}/api/assistant/flux
Authorization: Bearer {{jetonMembre}}
Content-Type: {{json}}

{ "question": "Où en sont mes réservations ?" }

### Question vide — 400
POST {{base}}/api/assistant/flux
Authorization: Bearer {{jetonMembre}}
Content-Type: {{json}}

{ "question": "   " }

### Question de plus de 500 caractères — 400
POST {{base}}/api/assistant/flux
Authorization: Bearer {{jetonMembre}}
Content-Type: {{json}}

{ "question": "" }

### Assistant sans jeton — 401
POST {{base}}/api/assistant/flux
Content-Type: {{json}}

{ "question": "Bonjour" }

### Effacer sa conversation — 204
DELETE {{base}}/api/assistant/memoire
Authorization: Bearer {{jetonMembre}}

############################################
#              DURCISSEMENT
############################################

### Origine non déclarée — 403
GET {{base}}/sante
Origin: https://pirate.example

### Origine déclarée — 200 avec Access-Control-Allow-Origin
GET {{base}}/sante
Origin: http://localhost:5173

### Déconnexion — 204 (révoque les refresh tokens)
POST {{base}}/api/auth/deconnexion
Authorization: Bearer {{jetonMembre}}

### Refresh token après déconnexion — 401
POST {{base}}/api/auth/rafraichir
Content-Type: {{json}}

{
  "refreshToken": "{{camille.response.body.refreshToken}}"
}

### Limitation : 11e appel à /api/auth depuis le démarrage du serveur — 429
### (redémarrer le serveur remet le compteur à zéro)
POST {{base}}/api/auth/connexion
Content-Type: {{json}}

{
  "email": "camille@example.net",
  "motDePasse": "Mauvais-Mot-2026"
}
